# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================
# Cloudflare D1 数据库配置 (您已在 Cloudflare 创建完成)
# ============================================================
CLOUDFLARE_D1_DATABASE_ID="6924b928-9984-4dd8-ab00-9ea22d4c71c6"
CLOUDFLARE_D1_DATABASE_NAME="daka-db"

# 可选：如果在外部 Node 服务器直连 Cloudflare D1 REST API，填入 Account ID 与 API Token
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""

# ============================================================
# （预留接口）微信打卡推送 / Server酱 SendKey
# ============================================================
# SERVERCHAN_DEFAULT_SENDKEY=""

# ============================================================
# （预留接口）后期如需无缝切换至 MemFireDB / PostgreSQL / MySQL 云端独立库
# ============================================================
# DATABASE_URL="postgresql://postgres:password@db.memfiredb.com:5432/daka"
